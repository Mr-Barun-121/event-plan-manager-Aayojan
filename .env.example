# ==============================================================
# Aayojan / EventGenie Environment Variables Configuration
# ==============================================================

# 1. Google Gemini AI API Key (Required for AI generation & Co-pilot)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Server Port & Execution Environment
PORT=3000
NODE_ENV=development

# 3. Application Base URL (Used for self-referential links and OAuth callbacks)
APP_URL="http://localhost:3000"

# 4. Optional: Firebase Web SDK Configuration (Cloud Persistence & Auth)
# If left with placeholders or omitted, Aayojan operates seamlessly in full offline mode using local browser storage!
# You can obtain these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"
